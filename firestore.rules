rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Each signed-in user can access their own profile document and subcollections.
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Fallback: Allow any authenticated user full read and write access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

